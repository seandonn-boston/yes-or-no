{
  "name": "yes-or-no",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file-if-exists=.env.local db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --env-file-if-exists=.env.local --test tests/*.test.ts",
    "db:seed:questions": "tsx --env-file-if-exists=.env.local db/seed-questions.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env.local db/seed.ts",
    "ai:answers": "tsx --env-file-if-exists=.env.local db/ai-answers.ts",
    "admin:role": "tsx --env-file-if-exists=.env.local db/set-role.ts",
    "db:migrate:deploy": "tsx db/migrate.ts",
    "vercel-build": "npm run db:migrate:deploy && next build"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "highcharts": "^13.1.1",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22"
  }
}
