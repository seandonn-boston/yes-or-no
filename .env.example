# ---- Required ----
DATABASE_URL=postgres://beliefmap:beliefmap@localhost:5432/beliefmap
# Secret used to hash phone numbers. Generate once (openssl rand -hex 32) and never change it:
# a new value orphans every existing account.
PHONE_PEPPER=change-me-to-a-long-random-string
# The site's public address, used in Stripe return links. Defaults to the Vercel URL.
SITE_URL=http://localhost:3000

# ---- Data ----
# Breakdowns (e.g. public vs private) are withheld for groups smaller than this.
MIN_GROUP_SIZE=5
# Comma-separated API keys. Callers send one as "Authorization: Bearer <key>".
API_KEYS=
# Reports from this many accounts take a question out of feeds until a moderator reviews it.
REPORT_THRESHOLD=5

# ---- Phone verification (Twilio Verify) ----
# Without these, development uses a code printed to the server log; production refuses signups.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Development only: fix the code instead of a random one (used by automated tests).
SMS_DEV_CODE=

# ---- Membership (Stripe) ----
# Without these, development switches tiers directly; production shows "opens soon".
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# ---- AI (optional) ----
# Screens new questions for repeats and harm, and powers npm run ai:answers.
ANTHROPIC_API_KEY=
MODERATION_MODEL=claude-haiku-5-5

# ---- Legal pages ----
CONTACT_EMAIL=
OPERATOR_NAME=
