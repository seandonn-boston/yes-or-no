DATABASE_URL=postgres://beliefmap:beliefmap@localhost:5432/beliefmap
# Secret used to hash phone numbers. Changing it orphans every existing account.
PHONE_PEPPER=change-me-to-a-long-random-string
# Breakdowns (e.g. public vs private) are withheld for groups smaller than this.
MIN_GROUP_SIZE=5
# Comma-separated API keys. Callers send one as "Authorization: Bearer <key>".
API_KEYS=
